# CURATOR CUDA profile — optional NVIDIA accelerator runtime with CPU fallback.
#
# The CPU image (packaging/docker/Dockerfile) is the supported default. This
# profile is opt-in for hosts with an NVIDIA GPU + driver; the application
# degrades gracefully to CPU when CUDA is requested but unavailable, so the CPU
# image remains fully functional on any host.
#
# Build:  docker build -f packaging/docker/Dockerfile.cuda -t curator:cuda .
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CURATOR_DATA_ROOT=/data \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN useradd --system --create-home --shell /usr/sbin/nologin curator

COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv \
    && uv sync --frozen --no-dev --no-install-project

COPY src ./src
RUN uv sync --frozen --no-dev

RUN mkdir -p /data && chown -R curator:curator /app /data
USER curator

EXPOSE 8765

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/health', timeout=3)"

ENTRYPOINT ["curator", "--headless", "start"]
